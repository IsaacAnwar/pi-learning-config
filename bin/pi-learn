#!/bin/sh
set -eu

# Resolve the installer-created symlink so resources follow the checkout.
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
bin_dir=$(CDPATH= cd -- "$(dirname "$script")" && pwd -P)
exec node "$bin_dir/pi-learn.mjs" "$@"
